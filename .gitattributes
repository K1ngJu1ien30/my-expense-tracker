# Auto-detect text files for LF normalization, then explicitly pin every
# source extension to LF so Windows checkouts (with core.autocrlf=true)
# don't silently re-introduce CRLF and produce whitespace-only diffs.
* text=auto eol=lf

# Source — always LF
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf

# Binary — never touch
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.apk   binary
